<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <queries>
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.tts" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
    
    <application
        android:name=".FocusApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusByRj">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FocusByRj">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dynamic Profile Avatar App Icon Aliases -->
        <activity-alias
            android:name=".MainActivityAliasWanderer"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wanderer"
            android:roundIcon="@mipmap/ic_launcher_wanderer"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasScholar"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_scholar"
            android:roundIcon="@mipmap/ic_launcher_scholar"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasKnight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_knight"
            android:roundIcon="@mipmap/ic_launcher_knight"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasNoble"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_noble"
            android:roundIcon="@mipmap/ic_launcher_noble"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasEmperor"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_emperor"
            android:roundIcon="@mipmap/ic_launcher_emperor"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasCompanion"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_companion"
            android:roundIcon="@mipmap/ic_launcher_companion"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasInferno"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_inferno"
            android:roundIcon="@mipmap/ic_launcher_inferno"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasChampion"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_champion"
            android:roundIcon="@mipmap/ic_launcher_champion"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasPrestige"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_prestige"
            android:roundIcon="@mipmap/ic_launcher_prestige"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasCrown"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_crown"
            android:roundIcon="@mipmap/ic_launcher_crown"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasPhoenix"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_phoenix"
            android:roundIcon="@mipmap/ic_launcher_phoenix"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        
        <activity
            android:name=".ui.screens.BlockActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="false"
            android:theme="@style/Theme.FocusByRj" />
        
        <receiver
            android:name=".service.FocusDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.FocusBlockerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App blocking and focus management" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.PackageChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    
        <receiver android:name=".service.TaskReminderReceiver" android:exported="false" />
        <receiver android:name=".service.TaskActionReceiver" android:exported="false" />
        <receiver android:name=".service.DailySummaryReceiver" android:exported="false" />
        <receiver android:name=".service.AptitudeReminderReceiver" android:exported="false" />
        <receiver android:name=".service.HabitReceiver" android:exported="false" />
        <receiver android:name=".service.HabitActionReceiver" android:exported="false" />

        <!-- Floating Task Reminder Popup Activity -->
        <activity
            android:name=".ui.screens.TaskReminderPopupActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=":bubble"
            android:exported="false" />

        <!-- Floating Quick Add Dialog Activity for Tasks -->
        <activity
            android:name=".ui.screens.QuickAddTaskActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Floating Quick Add Dialog Activity for Notes & Checklists -->
        <activity
            android:name=".widget.QuickAddNoteItemActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Floating Home Screen Direct Note Editor Dialog Activity -->
        <activity
            android:name=".widget.QuickEditNoteActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="true" />

        <!-- Share Target for Google Keep Notes, Checklists & Images -->
        <activity
            android:name=".ui.screens.notes.ShareToNoteActivity"
            android:exported="true"
            android:label="@string/share_to_focus_notes"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="@string/share_to_focus_notes">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/share_to_focus_notes">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_to_focus_notes">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_to_focus_notes">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_to_focus_notes">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Notes & Checklists Widget Configuration Activity -->
        <activity
            android:name=".widget.NoteWidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FocusByRj">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Notes & Checklists Interactive Home Screen Widget -->
        <receiver
            android:name=".widget.NoteWidgetProvider"
            android:label="Focus Notes &amp; Lists"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.focusbyrj.app.widget.ACTION_PREV_NOTE" />
                <action android:name="com.focusbyrj.app.widget.ACTION_NEXT_NOTE" />
                <action android:name="com.focusbyrj.app.widget.ACTION_CYCLE_FILTER" />
                <action android:name="com.focusbyrj.app.widget.ACTION_TOGGLE_ITEM" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/note_widget_info" />
        </receiver>

        <service
            android:name=".widget.NoteWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Todoist Style Widget Configuration Activity -->
        <activity
            android:name=".widget.TodoWidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FocusByRj">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Todoist Style Home Screen Widget -->
        <receiver
            android:name=".widget.TodoWidgetProvider"
            android:label="Focus Tasks"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.focusbyrj.app.widget.ACTION_SET_TAB" />
                <action android:name="com.focusbyrj.app.widget.ACTION_TOGGLE_TASK" />
                <action android:name="com.focusbyrj.app.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

        <service
            android:name=".widget.TodoWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <activity android:name=".ui.screens.BubbleChatActivity" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:launchMode="singleInstance" android:taskAffinity=":bubble" android:excludeFromRecents="true" />
        <service android:name=".service.BubbleService" android:exported="false" android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating assistant companion overlay" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

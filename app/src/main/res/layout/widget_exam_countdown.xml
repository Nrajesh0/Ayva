<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/exam_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/exam_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/exam_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="18dp">
        <TextView android:id="@+id/exam_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Exam countdown" android:textSize="16sp" android:textStyle="bold" android:textColor="#E8F4EE" />
        <TextView android:id="@+id/exam_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:text="30 days left" android:textSize="36sp" android:textStyle="bold" android:textColor="#8DC6B1" />
        <TextView android:id="@+id/exam_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:textSize="12sp" android:textColor="#E8F4EE" />
        <ProgressBar android:id="@+id/exam_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:max="100" />
        <TextView android:id="@+id/exam_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:layout_marginTop="6dp" android:textColor="#E8F4EE" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Emoji Avatar -->
        <FrameLayout
            android:id="@+id/notif_exp_emoji_bg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notification_emoji_circle">

            <TextView
                android:id="@+id/notif_exp_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="💧"
                android:textSize="22sp" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_exp_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hydrate &amp; Glow"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/notif_exp_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 of 6 completed today • Active window"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Optional Notes / Description -->
    <TextView
        android:id="@+id/notif_exp_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Stay refreshed and energized throughout the day."
        android:textColor="#CBD5E1"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/notif_exp_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="33"
        android:progressTint="#38BDF8"
        android:progressBackgroundTint="#1E293B" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1-Tap Log Action -->
        <TextView
            android:id="@+id/notif_exp_action_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_notification_action_pill"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="💧 Log (+1)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Snooze Action -->
        <TextView
            android:id="@+id/notif_exp_snooze_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notification_snooze_pill"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="9dp"
            android:text="⏳ +30m"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

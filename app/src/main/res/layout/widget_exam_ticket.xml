<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/exam_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/exam_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:id="@+id/exam_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="18dp">
<LinearLayout android:id="@+id/exam_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="4dp">
<TextView android:id="@+id/exam_badge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textStyle="bold" />
<TextView android:id="@+id/exam_edit" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingHorizontal="8dp" android:text="Edit" android:textSize="11sp" android:contentDescription="Edit exam widget" />
</LinearLayout>
<LinearLayout android:id="@+id/exam_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/exam_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="38sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp"><TextView android:id="@+id/exam_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/><TextView android:id="@+id/exam_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" /><TextView android:id="@+id/exam_venue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" /></LinearLayout></LinearLayout><ProgressBar android:id="@+id/exam_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="100" /><TextView android:id="@+id/exam_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" /><TextView android:id="@+id/exam_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="4dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/exam_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
<LinearLayout android:id="@+id/exam_navigation" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
<TextView android:id="@+id/exam_previous" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="24sp" android:contentDescription="Previous exam page" />
<TextView android:id="@+id/exam_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="11sp" />
<TextView android:id="@+id/exam_next" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="24sp" android:contentDescription="Next exam page" />
</LinearLayout>
</LinearLayout></FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Dynamic Item Background -->
    <ImageView
        android:id="@+id/widget_item_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_bg"
        android:contentDescription="Item Background" />

    <LinearLayout
        android:id="@+id/widget_item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <!-- Checkbox / Toggle Button -->
        <ImageView
            android:id="@+id/widget_item_checkbox"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_check_empty"
            android:contentDescription="Complete Task" />

        <!-- Title & Details -->
        <LinearLayout
            android:id="@+id/widget_item_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Title"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_item_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today 5:00 PM"
                    android:textColor="#2EE59D"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_item_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Recurring"
                    android:textColor="#A0ABA4"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
